# ---------- 站点 ----------
SITE_NAME=知屿
COLLEGE_NAME=XX大学XX学院

# ---------- 学校统一认证 ----------
AUTH_PROVIDER=email_fallback         # cas | oidc | email_fallback（开发期默认邮箱降级）
CAS_SERVER_URL=https://cas.school.edu.cn
AUTH_CALLBACK_URL=http://localhost:8080/api/auth/cas/callback

# ---------- 存储 ----------
POSTGRES_USER=knowisle
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=knowisle
DATABASE_URL=postgresql+asyncpg://knowisle:change-me-in-prod@postgres:5432/knowisle
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://seaweedfs:8333   # SeaweedFS S3 API（容器网络内地址）
S3_ACCESS_KEY=knowisle                  # 与 deploy/seaweedfs-s3.json 保持一致
S3_SECRET_KEY=knowisle_dev_secret
S3_BUCKET=knowisle-files
VECTOR_DB=chroma                     # chroma | pgvector（演进预留）
CHROMA_URL=http://chroma:8000

# ---------- 官方模型（平台统一提供，默认低价 API） ----------
OFFICIAL_LLM_BASE_URL=https://api.deepseek.com/v1
OFFICIAL_LLM_API_KEY=sk-xxxx
OFFICIAL_MODEL_SHORT=deepseek-chat
OFFICIAL_MODEL_MEDIUM=deepseek-chat
OFFICIAL_MODEL_LONG=deepseek-chat    # DeepSeek 单模型 64K；切换 Kimi 等时可配 8k/32k/128k 分档

# ---------- Embedding ----------
EMBEDDING_MODE=local
EMBEDDING_MODEL=bge-small-zh-v1.5

# ---------- AI 额度策略 ----------
AI_DAILY_FREE_QUOTA=30
AI_QUOTA_EXCHANGE_RATE=10            # 10 贡献分兑换 1 次额外问答

# ---------- 安全 ----------
SECRET_KEY=                          # 会话签名 + 自定义 Key 加密（Fernet），务必填入随机串

# ---------- 会话与令牌（v0.2，双通道：Redis Session 页面 + JWT API） ----------
# SESSION_TTL_SECONDS=604800         # 会话有效期（默认 7 天，滑动续期）
# JWT_TTL_SECONDS=604800             # API 通道 JWT 有效期（默认 7 天）

# ---------- 邮箱降级认证（v0.2 开发期默认通道） ----------
# EMAIL_CODE_TTL_SECONDS=600         # 验证码有效期（默认 10 分钟）
# EMAIL_CODE_COOLDOWN_SECONDS=60     # 同学号重发冷却（默认 60 秒）
# ALLOWED_EMAIL_SUFFIX=              # 校园邮箱域名限制，如 .edu.cn；空为不限制（演示便利）
# EMAIL_CODE_ECHO=true               # 开发期假通道：接口回显验证码 + 写日志；生产务必 false
